# --- DISCORD BOT CONFIGURATION ---
# Token bota z sekcji "Bot" w Developer Portal
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# ID Aplikacji z sekcji "General Information"
DISCORD_CLIENT_ID=your_discord_client_id_here

# Secret z sekcji "OAuth2 -> General" (używany do logowania na stronie)
DISCORD_CLIENT_SECRET=your_discord_client_secret_here

# URL przekierowania (musi być taki sam jak w Developer Portal -> OAuth2 -> Redirects)
DISCORD_REDIRECT_URI=https://your-domain.com/callback

# --- FLASK CONFIGURATION ---
# Dowolny długi ciąg znaków - chroni sesje użytkowników
FLASK_SECRET=your_flask_secret_here

# --- MEDIA API KEYS (Wymagane do działania powiadomień) ---
# Opcjonalne: Wygeneruj na https://console.cloud.google.com/
YOUTUBE_API_KEY=your_youtube_api_key_here

# Opcjonalne: Wygeneruj na https://dev.twitch.tv/console
TWITCH_CLIENT_ID=your_twitch_client_id_here
TWITCH_CLIENT_SECRET=your_twitch_client_secret_here

# --- STRIPE CONFIGURATION ---
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here
